<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= blogTitle %></title>
    <link rel="stylesheet" href="/css/blog.css">
    <style>
    *{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#f4f6f9;
    padding:40px;
}

.container{
    max-width:900px;
    margin:auto;
}

.blog-card{
    background:#fff;
    border-radius:12px;
    overflow:hidden;
    box-shadow:0 8px 20px rgba(0,0,0,.1);
}

.blog-image{
    width:100%;
    height:320px;
    object-fit:cover;
}

.blog-content{
    padding:30px;
}

.category{
    display:inline-block;
    background:#0d6efd;
    color:#fff;
    padding:6px 14px;
    border-radius:20px;
    font-size:14px;
    margin-bottom:18px;
}

h1{
    margin-bottom:12px;
    color:#222;
}

.meta{
    color:#777;
    font-size:14px;
    margin-bottom:20px;
}

.blog-content p{
    color:#555;
    line-height:1.8;
    margin-bottom:25px;
}

.btn{
    display:inline-block;
    text-decoration:none;
    background:#0d6efd;
    color:#fff;
    padding:12px 24px;
    border-radius:6px;
    transition:.3s;
}

.btn:hover{
    background:#084298;
}
</style>
</head>
<body>

    <div class="container">

        <div class="blog-card">

            <img
                src="https://images.unsplash.com/photo-1523381210434-271e8be1f52?w=1200"
                alt="Blog Banner"
                class="blog-image"
            >

            <div class="blog-content">

                <span class="category">Lifestyle</span>

                <h1><%= blogTitle %></h1>

                <p class="meta">
                    By John Doe • August 2026 • 5 min read
                </p>

                <p>
                    <%= blogContent %>
                </p>

                <a href="/" class="btn">
                    ← Back to Home
                </a>

            </div>

        </div>

    </div>

</body>
</html>